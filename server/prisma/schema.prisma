// server/prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  AGENT
  ADMIN
  COLLABORATOR
}

enum EstadoDenuncia {
  PENDIENTE
  APROBADO
  EN_PROCESO
  EN_VERIFICACION
  VERIFICADO_PENDIENTE
  EN_SANEAMIENTO
  RESUELTO_TECNICO
  RESUELTO
  RECHAZADO
  CERRADO_INACCESIBLE
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EstadoCanje {
  RESERVADO_PENDIENTE
  PENDIENTE_RETIRO
  ENTREGADO
  CANCELADO
}

// --------------------------------------------------------
// MULTI-TENANCY / MUNICIPIO
// --------------------------------------------------------
model Municipio {
  id        String     @id @default(uuid())
  nombre    String     // Ej: "Municipio de Pilar"
  codigo    String     @unique // Ej: "PILAR-BA"
  creadoEn  DateTime   @default(now())

  usuarios   User[]
  denuncias  Denuncia[]
  productos  Producto[]
  sucursales Sucursal[]

  @@map("municipios")
}

// --------------------------------------------------------
// SUCURSALES / PUNTOS DE RETIRO MUNICIPAL
// --------------------------------------------------------
model Sucursal {
  id          String    @id @default(uuid())
  nombre      String    // Ej: "Palacio Municipal Pilar", "Delegación Derqui"
  direccion   String
  horario     String?   // Ej: "Lunes a Viernes de 08:00 a 14:00 hs"
  activa      Boolean   @default(true)

  municipioId String
  municipio   Municipio @relation(fields: [municipioId], references: [id])
  canjes      Canje[]

  creadoEn    DateTime  @default(now())

  @@map("sucursales")
}

// --------------------------------------------------------
// USUARIOS Y ROLES (RBAC)
// --------------------------------------------------------
model User {
  id           String     @id @default(uuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          Role       @default(CITIZEN)
  puntos       Int        @default(0)
  disponible   Boolean    @default(true)
  latitudActual             Float?
  longitudActual            Float?
  ubicacionActualizadaEn    DateTime?
  
  municipioId  String
  municipio    Municipio  @relation(fields: [municipioId], references: [id])

  denunciasCreadas   Denuncia[] @relation("CiudadanoDenuncias")
  denunciasAsignadas Denuncia[] @relation("AgenteDenuncias")
  canjesRealizados   Canje[]    @relation("CiudadanoCanjes")

  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  @@map("usuarios")
}

// --------------------------------------------------------
// MÓDULO DE DENUNCIAS / ALERTAS AMBIENTALES
// --------------------------------------------------------
model Denuncia {
  id           String         @id @default(uuid())
  codigo       String         @unique // Ej: "REP-2026-001"
  titulo       String
  descripcion  String
  categoria    String         // "Microbasural", "Foco Dengue", "Terreno Baldío", "Otro"
  estado       EstadoDenuncia @default(PENDIENTE)
  prioridad    Prioridad      @default(MEDIA)
  
  // Ubicación GPS + Dirección de referencia
  direccion    String
  latitud      Float?
  longitud     Float?
  
  // Evidencias Fotográficas e Informes
  imagenUrl            String?   // Foto inicial "Antes" del Ciudadano
  fotoVerificacionUrl  String?   // Foto in-situ del Agente
  fotoSolucionUrl      String?   // Foto final "Después" del Agente
  informeSolucion      String?   // Informe técnico del Agente
  observacionesAdmin   String?   // Justificación de rechazo o notas de triaje

  // Reglas de negocio y auditoría
  puntosOtorgados      Int?      @default(0)
  intentosInaccesible  Int       @default(0)
  ocultarUsuario       Boolean   @default(false)

  municipioId  String
  municipio    Municipio      @relation(fields: [municipioId], references: [id])

  ciudadanoId  String
  ciudadano    User           @relation("CiudadanoDenuncias", fields: [ciudadanoId], references: [id])

  agenteId     String?
  agente       User?          @relation("AgenteDenuncias", fields: [agenteId], references: [id])

  fechaVerificacion DateTime?
  fechaResolucion   DateTime?
  creadoEn          DateTime      @default(now())
  actualizadoEn     DateTime      @updatedAt

  @@map("denuncias")
}

// --------------------------------------------------------
// MÓDULO DE TIENDA Y CANJE DE PUNTOS ECOLÓGICOS
// --------------------------------------------------------
model Producto {
  id          String      @id @default(uuid())
  titulo      String
  descripcion String
  categoria   String      @default("Otros")
  costoPuntos Int
  stock       Int         @default(10)
  imagenUrl   String?
  activo      Boolean     @default(true)

  municipioId String
  municipio   Municipio   @relation(fields: [municipioId], references: [id])

  itemsCanje  ItemCanje[]

  creadoEn    DateTime    @default(now())

  @@map("productos")
}

model Canje {
  id              String      @id @default(uuid())
  codigoRetiro    String      @unique // Ej: "ECO-7894-K"
  totalPuntos     Int
  estado          EstadoCanje @default(PENDIENTE_RETIRO)

  // Control de Reserva de 5 min y Caducidad a 30 días
  bloqueadoHasta  DateTime?
  fechaExpiracion DateTime?
  fechaEntrega    DateTime?

  // Sucursal física de retiro
  sucursalId      String?
  sucursal        Sucursal?   @relation(fields: [sucursalId], references: [id])

  ciudadanoId     String
  ciudadano       User        @relation("CiudadanoCanjes", fields: [ciudadanoId], references: [id])

  items           ItemCanje[]

  creadoEn        DateTime    @default(now())
  actualizadoEn   DateTime    @updatedAt

  @@map("canjes")
}

model ItemCanje {
  id          String   @id @default(uuid())
  cantidad    Int
  puntosUnit  Int

  canjeId     String
  canje       Canje    @relation(fields: [canjeId], references: [id], onDelete: Cascade)

  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id])

  @@map("items_canje")
}
{
  "name": "ecoalerta",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.13",
    "expo-location": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "tsconfig": {
          "types": ["jest", "node"]
        }
      }]
    },
    "testMatch": [
      "**/src/utils/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json"]
  },
  "private": true
}
